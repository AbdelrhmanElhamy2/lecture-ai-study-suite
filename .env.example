# ========================================================
# LectureAI Study Suite - Environment Configuration
# ========================================================

# 1. Google Gemini API Key (Required for live AI synthesis)
# Obtain your free API key from Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. AI Model Selection
# Default: gemini-3.8-flash (High speed, 1M context, robust multimodal reasoning)
GEMINI_MODEL=gemini-3.8-flash
