# ========================================================
# LectureAI Study Suite - Environment Configuration
# ========================================================

# 1. Google Gemini API Key (Required for live AI synthesis)
# Obtain your free API key from Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. AI Model Selection
# Primary: gemini-3.8-flash. The only automatic fallback is gemini-3.6-flash.
GEMINI_MODEL=gemini-3.8-flash

# 3. Local faster-whisper transcription (audio remains on this computer)
# First use may download model weights. CPU/int8 defaults suit many Windows laptops.
# Use "base" to reduce memory use, or "small" for the default multilingual model.
LECTUREAI_WHISPER_MODEL=small
LECTUREAI_WHISPER_DEVICE=cpu
LECTUREAI_WHISPER_COMPUTE_TYPE=int8

# 4. (Optional) Local / Google Drive folder that contains your course sub-folders.
# Used by "--list-courses", course folder search, and auto-saving PDFs to Drive.
# Example: LECTUREAI_COURSES_DIR=G:\My Drive\fall 2026
LECTUREAI_COURSES_DIR=
